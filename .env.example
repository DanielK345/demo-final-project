# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Core Agent structured language understanding (disabled by default)
AGENT_LLM_ENABLED=true
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=openai/gpt-5.6-luna-pro
AGENT_LLM_TIMEOUT_SECONDS=5
AGENT_LLM_REASONING_EFFORT=none
# Optional for an OpenAI-compatible gateway:
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1

# Contextual user-message rewrite (từ feature/agentic-ai — rollout độc lập, tắt mặc định)
AGENT_REWRITE_ENABLED=false
AGENT_REWRITE_PROVIDER=openai
AGENT_REWRITE_MODEL=openai/gpt-5.6-luna-pro
AGENT_REWRITE_TIMEOUT_SECONDS=5
AGENT_REWRITE_REASONING_EFFORT=none
# Optional for an OpenAI-compatible gateway:
AGENT_REWRITE_BASE_URL=https://openrouter.ai/api/v1
# Or use other providers:
# ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ASR_PLACE_REWRITE_ENABLED=true
ASR_PLACE_REWRITE_MODEL=gemini-2.0-flash
ASR_PLACE_REWRITE_TIMEOUT_SECONDS=3

# ---- Voice prototype (HTTP /api/v1/voice/turn — OpenAI/Gemini STT+TTS) ----
# auto = OpenAI if OPENAI_API_KEY else Gemini STT
VOICE_PROVIDER=auto
VOICE_STT_MODEL=gpt-4o-transcribe
# OpenAI STT fallback when ZipFormer/Gemini returns an unavailable error.
VOICE_STT_FALLBACK_MODEL=whisper-1
VOICE_TTS_PROVIDER=openai
VOICE_TTS_MODEL=tts-1
# Primary OpenAI TTS voice. Edge-TTS below is retained as a fallback.
VOICE_OPENAI_TTS_VOICE=nova
VOICE_GEMINI_MODEL=gemini-2.0-flash
VOICE_TIMEOUT_SECONDS=30
# Privacy-first post-ASR correction: current transcript only; numeric/email/ID PII is masked.
VOICE_TRANSCRIPT_REWRITE_ENABLED=true
VOICE_TRANSCRIPT_REWRITE_MODEL=gpt-4o-mini
VOICE_TRANSCRIPT_REWRITE_BASE_URL=https://api.openai.com/v1
VOICE_TRANSCRIPT_REWRITE_TIMEOUT_SECONDS=3
VOICE_TRANSCRIPT_REWRITE_REASONING_EFFORT=none
VOICE_TRANSCRIPT_REWRITE_MINIMUM_CONFIDENCE=0.85

# ---- LiveKit-native Voice Agent (migration target; legacy remains default) ----
# Set to livekit only after the current migration phase passes its acceptance gate.
VOICE_RUNTIME=legacy
# Frontend rollout switch. Change together only after the LiveKit E2E gate passes.
VITE_VOICE_RUNTIME=legacy
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=alosm-voice
LIVEKIT_NUM_IDLE_PROCESSES=1
# Baseline models currently verified by the team. They can be replaced with
# another LiveKit Inference model or a provider plugin supported by LiveKit Agents.
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=vi
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
LIVEKIT_TTS_LANGUAGE=vi
LIVEKIT_TURN_DETECTION=vad
# Phase 2 baseline. Set adaptive only after quota/cost and Vietnamese barge-in A/B review.
LIVEKIT_INTERRUPTION_MODE=vad
# Native LiveKit VAD endpointing tuned for Vietnamese address pauses.
LIVEKIT_ENDPOINTING_MODE=fixed
LIVEKIT_ENDPOINTING_MIN_DELAY_SECONDS=2.0
LIVEKIT_ENDPOINTING_MAX_DELAY_SECONDS=3.0
LIVEKIT_INTERRUPTION_MIN_DURATION_SECONDS=0.5
LIVEKIT_INTERRUPTION_MIN_WORDS=1
LIVEKIT_CRITICAL_CONFIDENCE_THRESHOLD=0.65
# Safe reprompt if STT emits partial text but no final segment.
LIVEKIT_STT_FINAL_FALLBACK_ENABLED=true
LIVEKIT_STT_FINAL_FALLBACK_SECONDS=3
# Privacy-safe defaults. Enable only after consent/retention policy is approved.
LIVEKIT_RECORD_AUDIO=false
LIVEKIT_RECORD_TRANSCRIPT=false
LIVEKIT_RECORD_TRACES=false
LIVEKIT_RECORD_LOGS=false
# Local JSONL diagnostics. Transcript content is a separate explicit opt-in.
LIVEKIT_DEBUG_EVENT_LOG=false
LIVEKIT_DEBUG_TRANSCRIPTS=false
LIVEKIT_DEBUG_LOG_DIR=logs/livekit
LIVEKIT_CONNECTION_TIMEOUT_SECONDS=10
LIVEKIT_TOKEN_TTL_SECONDS=600

# ---- Database ----
# Local dev/test mặc định: SQLite, không cần Supabase để chạy (pytest tự dùng cái này).
DATABASE_URL=sqlite:///./data/app.db
# Deploy thật (Supabase) — xem hướng dẫn đầy đủ tại docs/database_supabase.md:
# DATABASE_URL = connection string "Transaction pooler" (cổng 6543) — app runtime dùng cái này.
# DATABASE_URL_MIGRATIONS = connection string "Direct connection" (cổng 5432) — chỉ Alembic dùng.
# DATABASE_URL=postgresql://postgres.xxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DATABASE_URL_MIGRATIONS=postgresql://postgres.xxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Distributed ephemeral coordination (rate limits, locks, worker coordination).
# Leave empty for local development; production features requiring Redis must fail safe.
REDIS_URL=
DATABASE_READINESS_TIMEOUT_SECONDS=2

# ---- Maps / Geocoding / Routing ----
# Provider-neutral config. Set MAPS_PROVIDER=osm to enable Nominatim + OSRM stack.
MAPS_PROVIDER=
MAPS_API_KEY=
MAPS_BASE_URL=
MAPS_SERVICE_AREA_ID=

# Geocoding provider — self-hosted Nominatim (production) or public endpoint (DEV ONLY)
GEOCODING_PROVIDER=nominatim
# Production: http://localhost:8088 (self-hosted). DEV ONLY: https://nominatim.openstreetmap.org
# WARNING: public nominatim.openstreetmap.org has strict usage policy and NO SLA.
NOMINATIM_BASE_URL=http://localhost:8088

# Routing provider — self-hosted OSRM
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://localhost:5000

# Search / display defaults
MAP_COUNTRY_CODE=vn
MAP_SEARCH_LIMIT=5
MAP_REQUEST_TIMEOUT_SECONDS=5

# Service area — EXTERNAL_BLOCKED until Product/Ops provides GeoJSON polygon
# MAPS_SERVICE_AREA_PATH=data/service_area/hanoi.geojson

# OSM data version (informational, set after importing data)
OSM_DATA_VERSION=

# Tile provider — for frontend basemap rendering (separate from geocoding/routing)
# EXTERNAL_BLOCKED: Owner must choose self-hosted or managed tile provider for production.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors


# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Voice AI (docs/voice-ai/voice-runtime-architecture.md) — additive ----
VOICE_ENABLED=true
GROQ_API_KEY=
VOICE_ASR_MODEL=whisper-large-v3-turbo
VOICE_ASR_LANGUAGE=vi
# `VOICE_TTS_VOICE` là alias legacy; cấu hình mới chỉ dùng tên rõ nghĩa bên dưới.
# Edge-TTS legacy runtime; TTSOrchestrator bên dưới dùng cấu hình primary/fallback.
VOICE_EDGE_TTS_VOICE=vi-VN-HoaiMyNeural
# 1.0 = tự nhiên nhất; giá trị <1.0 (vd 0.9) làm giọng nghe robot/đơ hơn — chỉ hạ nếu
# thật sự cần chậm hơn cho người lớn tuổi, và nên test tai trước khi hạ quá 0.95.
VOICE_TTS_RATE=1.0
VOICE_TTS_PRIMARY_VOICE=vi-VN-HoaiMyNeural
VOICE_TTS_FALLBACK_VOICES=vi-VN-NamMinhNeural
VOICE_TTS_TIMEOUT_SECONDS=12
VOICE_TTS_REQUEST_DEADLINE_SECONDS=30
VOICE_TTS_MAX_ATTEMPTS_PER_VOICE=2
VOICE_TTS_CIRCUIT_FAILURE_THRESHOLD=1
VOICE_TTS_CIRCUIT_COOLDOWN_SECONDS=60
VOICE_TTS_MAX_CONCURRENCY=4
VOICE_TTS_QUEUE_SIZE=16
VOICE_TTS_MAX_TEXT_CHARS=2000
VOICE_TTS_MAX_AUDIO_BYTES=5242880
VOICE_TTS_FFMPEG_PATH=ffmpeg
VOICE_TTS_FFPROBE_PATH=ffprobe
VOICE_TTS_CACHE_MAX_ENTRIES=64
VOICE_TTS_CACHE_TTL_SECONDS=900
VOICE_TTS_CACHE_MAX_TEXT_CHARS=240
VOICE_BROWSER_TTS_FALLBACK_ENABLED=false
VOICE_VAD_BACKEND=energy
VOICE_VAD_SILENCE_MS=900
VOICE_SILERO_MODEL_PATH=
VOICE_MIN_UTTERANCE_RMS=0.01
VOICE_BRIEF_AMBIGUOUS_SOUND_ENABLED=true
VOICE_BRIEF_AMBIGUOUS_SOUND_MAX_DURATION_MS=700
VOICE_BRIEF_AMBIGUOUS_SOUND_MAX_CONFIDENCE=0.40
VOICE_BOOKING_CONFIRMATION_CONFIDENCE_THRESHOLD=0.80
# ---- Local Vietnamese ASR (sherpa-onnx ZipFormer INT8 CPU) ----
ASR_ENABLED=true
ASR_REQUIRED=false
ASR_MODEL_ID=hynt/Zipformer-30M-RNNT-6000h
ASR_MODEL_REVISION=24ed30248e1c96bb690c81c24ab4e056f8cd9fce
ASR_MODEL_DIR=data/models/asr/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09
ASR_ENCODER_PATH=encoder.int8.onnx
ASR_DECODER_PATH=decoder.onnx
ASR_JOINER_PATH=joiner.int8.onnx
ASR_TOKENS_PATH=tokens.txt
ASR_NUM_THREADS=2
ASR_MAX_CONCURRENCY=2
ASR_QUEUE_SIZE=8
ASR_SAMPLE_RATE=16000
ASR_FEATURE_DIM=80
ASR_INFERENCE_TIMEOUT_SECONDS=45
MAX_AUDIO_SIZE_MB=15
MAX_AUDIO_DURATION_SECONDS=60
ASR_FFMPEG_PATH=ffmpeg
# Set VOICE_PROVIDER=zipformer to require local STT for /api/v1/voice/turn.

# Generate two different values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QUOTE_SIGNING_KEY=
FIELD_ENCRYPTION_KEY=
