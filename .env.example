# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Voice AI (docs/prompt_voice_integration_real_be_fe.md) — additive ----
VOICE_ENABLED=true
GROQ_API_KEY=
VOICE_ASR_MODEL=whisper-large-v3-turbo
VOICE_ASR_LANGUAGE=vi
VOICE_TTS_VOICE=vi-VN-HoaiMyNeural
# 1.0 = tự nhiên nhất; giá trị <1.0 (vd 0.9) làm giọng nghe robot/đơ hơn — chỉ hạ nếu
# thật sự cần chậm hơn cho người lớn tuổi, và nên test tai trước khi hạ quá 0.95.
VOICE_TTS_RATE=1.0
VOICE_VAD_BACKEND=energy
VOICE_VAD_SILENCE_MS=900
VOICE_SILERO_MODEL_PATH=
VOICE_MIN_UTTERANCE_RMS=0.01
VOICE_BOOKING_CONFIRMATION_CONFIDENCE_THRESHOLD=0.80
