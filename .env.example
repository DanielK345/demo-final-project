# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Core Agent structured language understanding (disabled by default)
AGENT_LLM_ENABLED=true
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=openai/gpt-5.6-luna-pro
AGENT_LLM_TIMEOUT_SECONDS=5
AGENT_LLM_REASONING_EFFORT=none
# Optional for an OpenAI-compatible gateway:
AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1

# Contextual user-message rewrite (từ feature/agentic-ai — rollout độc lập, tắt mặc định)
AGENT_REWRITE_ENABLED=false
AGENT_REWRITE_PROVIDER=openai
AGENT_REWRITE_MODEL=openai/gpt-5.6-luna-pro
AGENT_REWRITE_TIMEOUT_SECONDS=5
AGENT_REWRITE_REASONING_EFFORT=none
# Optional for an OpenAI-compatible gateway:
AGENT_REWRITE_BASE_URL=https://openrouter.ai/api/v1
# ---- LiveKit-native Voice Agent ----
# Each developer may use a separate LiveKit Cloud project. These three values
# must come from the same project; never commit real credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=alosm-voice
LIVEKIT_NUM_IDLE_PROCESSES=1
LIVEKIT_STATE_RESTORE_TIMEOUT_SECONDS=10
# Product default: retain the Room for LiveKit's departure grace period. Set true
# only in isolated smoke projects where immediate Room cleanup is intentional.
LIVEKIT_DELETE_ROOM_ON_CLOSE=false
# Current verified Vietnamese STT baseline uses Google Cloud through LiveKit's
# official plugin. Enable Speech-to-Text API and use ADC or a credential file.
LIVEKIT_STT_PROVIDER=google
LIVEKIT_STT_MODEL=chirp_2
LIVEKIT_STT_LANGUAGE=vi-VN
# Example: /absolute/path/to/google-application-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_STT_LOCATION=asia-southeast1
# The LLM uses OPENAI_API_KEY directly. TTS stays on the verified Vietnamese
# LiveKit Inference / Cartesia baseline so every teammate gets the same voice.
LIVEKIT_LLM_PROVIDER=openai
LIVEKIT_LLM_MODEL=gpt-4.1-mini
LIVEKIT_TTS_PROVIDER=livekit
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
LIVEKIT_TTS_LANGUAGE=vi
LIVEKIT_TURN_DETECTION=vad
# Phase 2 baseline. Set adaptive only after quota/cost and Vietnamese barge-in A/B review.
LIVEKIT_INTERRUPTION_MODE=vad
# Native LiveKit VAD endpointing tuned for Vietnamese address pauses.
LIVEKIT_ENDPOINTING_MODE=fixed
LIVEKIT_ENDPOINTING_MIN_DELAY_SECONDS=0.8
LIVEKIT_ENDPOINTING_MAX_DELAY_SECONDS=2.5
LIVEKIT_TRANSCRIPTION_TIMEOUT_SECONDS=5
LIVEKIT_INTERRUPTION_MIN_DURATION_SECONDS=0.5
LIVEKIT_INTERRUPTION_MIN_WORDS=0
LIVEKIT_CRITICAL_CONFIDENCE_THRESHOLD=0.65
# Safe reprompt if STT emits partial text but no final segment.
LIVEKIT_STT_FINAL_FALLBACK_ENABLED=true
LIVEKIT_STT_FINAL_FALLBACK_SECONDS=3
# Privacy-safe defaults. Enable only after consent/retention policy is approved.
LIVEKIT_RECORD_AUDIO=false
LIVEKIT_RECORD_TRANSCRIPT=false
LIVEKIT_RECORD_TRACES=false
LIVEKIT_RECORD_LOGS=false
# Local JSONL diagnostics. Transcript content is a separate explicit opt-in.
LIVEKIT_DEBUG_EVENT_LOG=false
LIVEKIT_DEBUG_TRANSCRIPTS=false
LIVEKIT_DEBUG_LOG_DIR=logs/livekit
LIVEKIT_CONNECTION_TIMEOUT_SECONDS=10
LIVEKIT_TOKEN_TTL_SECONDS=600

# ---- Database ----
# Local dev/test mặc định: SQLite, không cần Supabase để chạy (pytest tự dùng cái này).
DATABASE_URL=sqlite:///./data/app.db
DATABASE_POOL_MODE=auto
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=300
# Deploy thật (Supabase) — xem hướng dẫn đầy đủ tại docs/database_supabase.md:
# Persistent FastAPI/LiveKit workers: prefer Direct or Session pooler port 5432.
# Temporary/serverless runtime: Transaction pooler port 6543; auto mode uses NullPool.
# DATABASE_URL_MIGRATIONS = Direct connection port 5432, reserved for Alembic.
# DATABASE_URL=postgresql://postgres.xxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# DATABASE_URL_MIGRATIONS=postgresql://postgres.xxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Distributed ephemeral coordination (rate limits, locks, worker coordination).
# Leave empty for local development; production features requiring Redis must fail safe.
REDIS_URL=
DATABASE_READINESS_TIMEOUT_SECONDS=2

# ---- Maps / Geocoding / Routing ----
# Provider-neutral config. Set MAPS_PROVIDER=osm to enable Nominatim + OSRM stack.
MAPS_PROVIDER=
MAPS_API_KEY=
MAPS_BASE_URL=
MAPS_SERVICE_AREA_ID=

# Geocoding provider — self-hosted Nominatim (production) or public endpoint (DEV ONLY)
GEOCODING_PROVIDER=nominatim
# Production: http://localhost:8088 (self-hosted). DEV ONLY: https://nominatim.openstreetmap.org
# WARNING: public nominatim.openstreetmap.org has strict usage policy and NO SLA.
NOMINATIM_BASE_URL=http://localhost:8088

# Routing provider — self-hosted OSRM
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://localhost:5000

# Search / display defaults
MAP_COUNTRY_CODE=vn
MAP_SEARCH_LIMIT=5
MAP_REQUEST_TIMEOUT_SECONDS=5

# Service area — EXTERNAL_BLOCKED until Product/Ops provides GeoJSON polygon
# MAPS_SERVICE_AREA_PATH=data/service_area/hanoi.geojson

# OSM data version (informational, set after importing data)
OSM_DATA_VERSION=

# Tile provider — for frontend basemap rendering (separate from geocoding/routing)
# EXTERNAL_BLOCKED: Owner must choose self-hosted or managed tile provider for production.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors


# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Generate two different values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
QUOTE_SIGNING_KEY=
FIELD_ENCRYPTION_KEY=

# ── Zipformer ASR Server ──────────────────────────────────────────────
# URL for LiveKit agent to connect to ASR server
ZIPFORMER_WS_URL=ws://localhost:9000/v1/stt

# Model directory (download from HuggingFace or Kaggle)
ZIPFORMER_MODEL_DIR=data/models/asr/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09

# sherpa-onnx provider: cpu | cuda
SHERPA_PROVIDER=cpu
ASR_NUM_THREADS=2
ASR_SAMPLE_RATE=16000
ASR_CHUNK_SIZE=320

# ASR server host/port
ASR_SERVER_HOST=0.0.0.0
ASR_SERVER_PORT=9000

# LiveKit Voice Runtime
VOICE_RUNTIME=livekit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=alosm-voice

# STT/LLM/TTS for LiveKit agent (must use provider/ prefix)
LIVEKIT_STT_MODEL=openai/gpt-4o-transcribe
LIVEKIT_STT_LANGUAGE=vi
LIVEKIT_LLM_MODEL=openai/gpt-4.1-mini
LIVEKIT_TTS_MODEL=openai/gpt-4o-mini-tts
LIVEKIT_TTS_VOICE=shimmer
LIVEKIT_TTS_LANGUAGE=vi

# VAD for Vietnamese (wider pauses than English)
LIVEKIT_ENDPOINTING_MIN_DELAY_SECONDS=2.0
LIVEKIT_ENDPOINTING_MAX_DELAY_SECONDS=3.0
LIVEKIT_INTERRUPTION_MIN_DURATION_SECONDS=0.5
LIVEKIT_INTERRUPTION_MIN_WORDS=1

# Debug transcripts (dev only)
LIVEKIT_DEBUG_EVENT_LOG=false
LIVEKIT_DEBUG_TRANSCRIPTS=false

# ── Maps / OpenStreetMap Ecosystem (Nominatim & OSRM) ───────────────────
MAPS_PROVIDER=osm
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AloSM/1.0 (ride-hailing; ops@alosm.vn)
NOMINATIM_TIMEOUT_SECONDS=5.0
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=10.0
MAP_DEFAULT_CITY=Hà Nội
MAP_DEFAULT_COUNTRY=Vietnam
MAP_SEARCH_LIMIT=5
MAP_CACHE_ENABLED=true
MAP_CACHE_TTL_SECONDS=3600
