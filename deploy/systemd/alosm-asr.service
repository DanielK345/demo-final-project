[Unit]
Description=AloSM Zipformer Streaming ASR Server
After=network.target

[Service]
Type=simple
User=alosm
Group=alosm
WorkingDirectory=/opt/alosm
EnvironmentFile=/opt/alosm/.env.production
ExecStart=/opt/alosm/.venv/bin/uvicorn asr_server.server:app --host 0.0.0.0 --port 9000
Restart=always
RestartSec=5s
LimitNOFILE=65536

# Security sandbox
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
