# ---- Zipformer Streaming ASR Server ----
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-asr.txt ./
RUN pip install --no-cache-dir -r requirements-asr.txt

# Non-root user
RUN useradd -m -u 1000 appuser

COPY asr_server/ ./asr_server/
COPY scripts/download_model.py ./scripts/
COPY pyproject.toml ./

# Model directory
RUN mkdir -p /app/data/models/asr && chown -R appuser:appuser /app

USER appuser

ENV ASR_SERVER_HOST=0.0.0.0 \
    ASR_SERVER_PORT=9000 \
    ASR_NUM_THREADS=4 \
    PYTHONUNBUFFERED=1

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

CMD ["uvicorn", "asr_server.server:app", "--host", "0.0.0.0", "--port", "9000"]
